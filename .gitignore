# 1. Ignore absolutely everything at the root level by default
/*

# 2. Whitelist ONLY the core files Quartz needs to compile on Vercel
!/quartz/
!/quartz/**
!/.github/
!/.github/**
!/package.json
!/tsconfig.json
!/quartz.config.ts
!/quartz.layout.ts
!/.gitignore

# 3. Whitelist ONLY the _player folder and everything inside it
!/_player/
!/_player/**

# 4. Standard system ignores
.DS_Store
.obsidian/
.quartz-cache/
node_modules/
