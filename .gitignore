node_modules/

# Lock down all other personal folders explicitly so they never sync
/00_Miscellaneous/
/01_Acts and Sections/
/02_NPCs and Factions/
/03_Locations/
/04_Items/
/05_Mechanics/
/06_Bestiary/
/Players Handbook/
/z_Images/
/z_Templates/

# Keep the framework essentials unlocked
!/quartz/
!/package.json
!/tsconfig.json
!/quartz.config.ts
!/quartz.layout.ts
!/.gitignore

